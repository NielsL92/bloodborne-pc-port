+// Explicit test input, never enabled by a normal baseline launch.
+bool ImeDialogState::SetResearchText(std::string_view text) {
+    if (text.empty() || text.size() > max_text_length || text.size() > 16 ||
+        !std::all_of(text.begin(), text.end(), [](unsigned char c) {
+            return (c >= 'A' && c <= 'Z') || (c >= 'a' && c <= 'z') ||
+                   (c >= '0' && c <= '9');
+        })) {
+        return false;
+    }
+    current_text.FromString(text);
+    input_changed = true;
+    return true;
+}
+
 bool ImeDialogState::CallTextFilter() {
     if (!text_filter || !input_changed) {
         return true;
