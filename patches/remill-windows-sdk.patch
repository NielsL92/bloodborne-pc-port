diff --git a/CMakeLists.txt b/CMakeLists.txt
index e0695e7..3f2ab1c 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -36,10 +36,31 @@ message(STATUS "Compiler ID is ${CMAKE_C_COMPILER_ID}")
 
 # LLVM
 find_package(LLVM CONFIG REQUIRED)
+# Relocate the official Windows SDK's absolute build-machine DIA dependency.
+if(WIN32 AND LLVM_ENABLE_DIA_SDK AND TARGET LLVMDebugInfoPDB)
+  find_library(REMILL_DIA_GUIDS NAMES diaguids
+    PATHS "$ENV{VSINSTALLDIR}/DIA SDK/lib/amd64" NO_DEFAULT_PATH REQUIRED)
+  get_target_property(_remill_pdb_deps LLVMDebugInfoPDB INTERFACE_LINK_LIBRARIES)
+  set(_remill_pdb_relocated)
+  foreach(_dep IN LISTS _remill_pdb_deps)
+    if(_dep MATCHES "diaguids[.]lib$")
+      list(APPEND _remill_pdb_relocated "${REMILL_DIA_GUIDS}")
+    else()
+      list(APPEND _remill_pdb_relocated "${_dep}")
+    endif()
+  endforeach()
+  set_property(TARGET LLVMDebugInfoPDB PROPERTY INTERFACE_LINK_LIBRARIES "${_remill_pdb_relocated}")
+endif()
 # https://github.com/JonathanSalwan/Triton/issues/1082#issuecomment-1030826696
 if(LLVM_LINK_LLVM_DYLIB)
   set(llvm_libs LLVM)
 else()
+  set(REMILL_OPTIONAL_TARGET_LIBS)
+  if("Sparc" IN_LIST LLVM_TARGETS_TO_BUILD)
+    list(APPEND REMILL_OPTIONAL_TARGET_LIBS sparccodegen sparcasmparser)
+  else()
+    message(WARNING "LLVM SDK omits SPARC code generation; AMD64 lifting experiment only")
+  endif()
   llvm_map_components_to_libnames(llvm_libs
     support core irreader
     bitreader bitwriter
@@ -48,7 +69,7 @@ else()
     armcodegen armasmparser
     interpreter mcjit
     x86info x86codegen x86asmparser
-    sparccodegen sparcasmparser)
+    ${REMILL_OPTIONAL_TARGET_LIBS})
 endif()
 message(STATUS "LLVM Libraries: ${llvm_libs}")
 
